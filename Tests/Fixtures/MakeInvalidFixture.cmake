# Пишет заведомо непригодный файл в каталог фикстур.
#
# broken_file и empty_file — не код, а данные: проверяется, что сканирование
# переживает мусор в каталоге игр. Отдельная цель (а не file(WRITE) на этапе
# конфигурации) нужна, чтобы «сборка фикстур» была одной командой и чтобы
# испорченный файл пересоздавался после ctest, который мог его перезаписать.
#
# Переменные:
#   OUTPUT — путь к файлу
#   CONTENT — содержимое; пустая строка даёт файл нулевой длины

if("${CONTENT}" STREQUAL "")
    file(WRITE "${OUTPUT}" "")
else()
    file(WRITE "${OUTPUT}" "${CONTENT}")
endif()
